# Two literals with an expression between them are two requirements. Joining
# them would invent a version that matches nothing.
python_requirement(
    name="conditional",
    requirements=["decorator==5.1.0" if PY39 else "decorator==5.1.1"],
    resolve="tools",
)

# A requirement built by a method call is not a requirement on the template the
# call is made on. Reporting `flask=={}` would put a version into a format
# string the next time the pin moved.
python_requirement(
    name="templated",
    requirements=["flask=={}".format(FLASK_VERSION)],
)

# The dangerous shape: the template alone parses as a valid pin, so a manager
# that stops at "does this look like a requirement" would edit it.
python_requirement(
    name="stripped",
    requirements=["alembic==1.11.0 ".strip()],
)

# Concatenation. The pin is `foo==1.0rc1`, so neither part is a requirement.
python_requirement(
    name="concatenated",
    requirements=["foo==1.0" + "rc1"],
)

# An interpolated literal. It takes part in the value wherever it sits, so the
# literals around it are not the pin, and they do not join across it either.
python_requirement(
    name="interpolated",
    requirements=["httpx==1.0" f"-{BUILD_SUFFIX}"],
)

# A subscript takes part of the literal, so the literal is not the value.
python_requirement(
    name="subscripted",
    requirements=["starlette==1.0.0"[0:14]],
)
