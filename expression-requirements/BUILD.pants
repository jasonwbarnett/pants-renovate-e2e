# Python picks one arm when Pants parses this file, so the field holds one
# string. Neither arm is reliably it, and reporting both would let a single
# branch bump both to the same version -- leaving a conditional whose arms are
# identical, which is still valid Python and no longer conditional on anything.
python_requirement(
    name="conditional",
    requirements=["decorator==5.1.0" if PY39 else "decorator==5.1.1"],
    resolve="tools",
)

# Abandoning an element must not abandon its neighbours.
python_requirement(
    name="conditional-with-sibling",
    requirements=[
        "orjson==3.9.0" if PY39 else "orjson==3.9.1",
        "chardet==7.6.0",
    ],
    resolve="tools",
)

# A requirement built by a method call is not a requirement on the template the
# call is made on. Reporting `flask=={}` would put a version into a format
# string the next time the pin moved.
python_requirement(
    name="templated",
    requirements=["flask=={}".format(FLASK_VERSION)],
)

# The dangerous shape: the template alone parses as a valid pin, so a manager
# that stops at "does this look like a requirement" would edit it.
python_requirement(
    name="stripped",
    requirements=["alembic==1.11.0 ".strip()],
)

# Concatenation. The pin is `foo==1.0rc1`, so neither part is a requirement.
python_requirement(
    name="concatenated",
    requirements=["foo==1.0" + "rc1"],
)

# An interpolated literal. It takes part in the value wherever it sits, so the
# literals around it are not the pin, and they do not join across it either.
python_requirement(
    name="interpolated",
    requirements=["httpx==1.0" f"-{BUILD_SUFFIX}"],
)

# A subscript takes part of the literal, so the literal is not the value.
python_requirement(
    name="subscripted",
    requirements=["starlette==1.0.0"[0:14]],
)

# A call's arguments are not requirements. Reading into the call would report a
# pin on a package this target never declares.
python_requirement(
    name="callarg",
    requirements=[shared_pin("django==4.2.0")],
)

# A parenthesised run of literals cannot be told apart from a call's arguments
# by this parser, so it is reported as nothing rather than guessed at. Asserted
# so that it stays deliberate.
python_requirement(
    name="grouped",
    requirements=[("pyarrow==14.0.0")],
)

# An expression around the whole value rather than inside it. Only one arm is
# named, so an update would edit an arm that may not be the one in use and leave
# the live one stale, with nothing in the diff to show it.
python_requirement(
    name="selected",
    requirements=["pendulum==2.1.2"] if PY39 else ["pendulum==3.0.0"],
)

# `and` is worse: Python yields the other operand, so the requirement read is
# not in the field under any condition.
python_requirement(
    name="conjoined",
    requirements=["shapely==2.0.0"] and EXTRA_REQUIREMENTS,
)

# The arithmetic around a list preserves membership, so this one is a real pin
# and is updated where it is written.
python_requirement(
    name="extended",
    requirements=["croniter==1.4.1"] + EXTRA_REQUIREMENTS,
)
